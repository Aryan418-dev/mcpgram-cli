{
  "name": "@mcpgram/cli",
  "version": "0.1.0",
  "description": "Official MCPGRAM CLI — install once, login once, configure every AI agent automatically",
  "type": "module",
  "bin": {
    "mcpgram": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "mcpgram",
    "cli",
    "claude",
    "cursor",
    "codex",
    "ai-agents"
  ],
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "conf": "^13.1.0",
    "open": "^10.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}

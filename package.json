{
  "name": "@mcpgram/cli",
  "version": "0.3.0",
  "description": "Official MCPGRAM CLI — login once, configure every AI agent, manage tools & servers",
  "type": "module",
  "bin": {
    "mcpgram": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "scripts",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run build && node --test test/*.test.js",
    "lint": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run test",
    "pack:check": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "mcpgram",
    "cli",
    "claude",
    "cursor",
    "codex",
    "ai-agents",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aryan418-dev/mcpgram-cli.git"
  },
  "homepage": "https://mcpgram.vercel.app",
  "bugs": {
    "url": "https://github.com/Aryan418-dev/mcpgram-cli/issues"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "open": "^10.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
